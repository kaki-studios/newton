# Copy to .env and fill in for local development. `.env` is gitignored; never commit real values.
#
# With no backend at all, `npm run dev` is the development loop and the AI is simply unavailable.
# `npm run dev:full` starts the Go server against the fake model provider: no key, no spend.

# The absolute origin the browser uses. OAuth callbacks are built from it.
BASE_URL=http://localhost:8080

# Leave false to serve the simulator with the AI paused.
CHAT_ENABLED=false

# fake works with no credentials. For the real thing: PROVIDER=openai, MODEL=<id>, and a key file.
PROVIDER=fake
MODEL=

# Spend controls. DAILY_GENERATIONS=10, MAX_CONVERSATION_TURNS=6 is the documented default.
DAILY_GENERATIONS=10
MAX_CONVERSATION_TURNS=6

# Sign-in. Each value is a *file path*, not the secret itself: the server reads the file once.
# Locally, `printf 'value\n' > /tmp/newton/gh_id` and point these at it.
# GITHUB_CLIENT_ID_FILE=/run/secrets/github_client_id
# GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_client_secret
# SESSION_KEY_FILE=/run/secrets/session_key
# PROVIDER_API_KEY_FILE=/run/secrets/provider_api_key

LOG_LEVEL=info
