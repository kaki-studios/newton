{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gravity": {
      "default": {
        "x": 0,
        "y": -9.81
      },
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "bodies": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "static",
              "kinematic",
              "dynamic"
            ]
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "angle": {
            "default": 0,
            "type": "number"
          },
          "density": {
            "default": 1,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "shape": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "circle"
                  },
                  "radius": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "kind",
                  "radius"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "box"
                  },
                  "halfWidth": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "halfHeight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "kind",
                  "halfWidth",
                  "halfHeight"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "edge"
                  },
                  "a": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "b": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "kind",
                  "a",
                  "b"
                ],
                "additionalProperties": false
              }
            ]
          },
          "linearVelocity": {
            "default": {
              "x": 0,
              "y": 0
            },
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "position",
          "shape"
        ],
        "additionalProperties": false
      }
    },
    "joints": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "distance"
              },
              "bodyA": {
                "type": "string",
                "minLength": 1
              },
              "bodyB": {
                "type": "string",
                "minLength": 1
              },
              "localAnchorA": {
                "default": {
                  "x": 0,
                  "y": 0
                },
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "localAnchorB": {
                "default": {
                  "x": 0,
                  "y": 0
                },
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "length": {
                "type": "number",
                "minimum": 0
              },
              "collideConnected": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "bodyA",
              "bodyB"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "bodies"
  ],
  "additionalProperties": false
}
