{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["node"]
  },
  // `demo.json` is fetched at runtime, so tsc has to copy it into dist/ alongside main.js.
  "include": ["src", "src/**/*.json"]
}
